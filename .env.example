APP_NAME="Instant Payment Ledger & API"
ENVIRONMENT=local

POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# Used by the api service inside docker-compose; overridden there to point at the db service.
# Used as-is when running the app directly on the host against a local Postgres.
DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger
